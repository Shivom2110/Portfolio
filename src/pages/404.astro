---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Shivom Raskar" description="This page doesn't exist.">
    <section class="not-found">
        <p class="eyebrow">&mdash; 404</p>
        <h1>This page doesn't exist.</h1>
        <p>Whatever you were looking for isn't here — but the rest of the site is.</p>
        <a href="/" class="home-link">Back to home &#8599;</a>
    </section>
</BaseLayout>

<style>
    .not-found {
        min-height: 70vh;
        background: var(--color-ink);
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 8rem 2rem;
    }
    .eyebrow {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-gold);
        margin: 0 0 1rem;
    }
    .not-found h1 {
        font-family: var(--font-sans);
        font-weight: 800;
        font-size: clamp(1.8rem, 5vw, 2.8rem);
        margin: 0 0 1rem;
    }
    .not-found p { color: var(--color-text-muted); margin: 0 0 2rem; }
    .home-link {
        color: var(--color-gold);
        text-decoration: none;
        font-weight: 700;
        border: 1px solid var(--color-gold);
        border-radius: 999px;
        padding: 0.75rem 1.75rem;
        transition: background 0.25s var(--ease-standard);
    }
    .home-link:hover { background: rgba(194, 165, 110, 0.1); }
</style>
